        <mxCell id="VIUGaLMYNlVvoc_84mti-21" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;Obs.:&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;font&gt;&lt;font style=&quot;&quot;&gt;V&lt;/font&gt;in&lt;/font&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[x-1]&lt;/font&gt;,&amp;nbsp;&lt;font&gt;P&lt;/font&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[x-1]&lt;/font&gt; e Vref&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;[x-1]&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); background-color: transparent;&quot;&gt;&amp;nbsp;da saída são valores atualizados com &lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); background-color: transparent;&quot;&gt;V&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); background-color: transparent;&quot;&gt;in&lt;font style=&quot;font-size: 10px;&quot;&gt;[x],&lt;/font&gt;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); background-color: transparent;&quot;&gt;P&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[x] e &lt;/font&gt;&lt;font&gt;Vref&lt;/font&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[x]&lt;/font&gt;, e vão para o banco de registradores.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;font&gt;V&lt;/font&gt;ref é o valor de referência atualizado que vai para o banco de registradores e para o próximo bloco.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;Dc&lt;/span&gt;&amp;nbsp;é o valor de comando do duty controller, 00 indica que deve diminuir, 01 indica que deve aumentar e 10 matém. Definido baseado na comparação de Vref&lt;font style=&quot;font-size: 10px;&quot;&gt;[x]&lt;/font&gt; com Vref&lt;font style=&quot;font-size: 10px;&quot;&gt;[x-1]&lt;/font&gt;.&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="238" x="357" y="-17" as="geometry" />
